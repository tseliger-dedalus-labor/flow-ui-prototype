<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flowprototype</groupId>
        <artifactId>backend-modules</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>appointments</artifactId>
    <version>1.0.0</version>
    <name>Appointments backend</name>

    <dependencies>
        <dependency>
            <groupId>com.flowprototype</groupId>
            <artifactId>flow-platform</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.flowprototype</groupId>
            <artifactId>patient-workflow</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/../../frontend/projects/appointments/src</directory>
                <includes>
                    <include>appointments.components.json</include>
                </includes>
                <targetPath>META-INF/flow-components</targetPath>
            </resource>
        </resources>
    </build>
</project>
