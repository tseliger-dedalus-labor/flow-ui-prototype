/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "paths": {
      "appointments": [
        "./dist/appointments"
      ],
      "flow-editor": [
        "./dist/flow-editor"
      ],
      "flow-platform": [
        "./dist/flow-platform"
      ],
      "laboratory-portal": [
        "./dist/laboratory-portal"
      ],
      "patient-workflow": [
        "./dist/patient-workflow"
      ],
      "ui-framework": [
        "./dist/ui-framework"
      ]
    },
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "references": [
    {
      "path": "./projects/ui-framework/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui-framework/tsconfig.spec.json"
    },
    {
      "path": "./projects/flow-platform/tsconfig.lib.json"
    },
    {
      "path": "./projects/flow-platform/tsconfig.spec.json"
    },
    {
      "path": "./projects/patient-workflow/tsconfig.lib.json"
    },
    {
      "path": "./projects/patient-workflow/tsconfig.spec.json"
    },
    {
      "path": "./projects/appointments/tsconfig.lib.json"
    },
    {
      "path": "./projects/appointments/tsconfig.spec.json"
    },
    {
      "path": "./projects/flow-editor/tsconfig.lib.json"
    },
    {
      "path": "./projects/flow-editor/tsconfig.spec.json"
    },
    {
      "path": "./projects/laboratory-portal/tsconfig.lib.json"
    },
    {
      "path": "./projects/laboratory-portal/tsconfig.spec.json"
    }
  ]
}
